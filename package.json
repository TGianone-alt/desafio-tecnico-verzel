{
  "name": "verzel-store-qa-vzs-142",
  "version": "1.0.0",
  "private": true,
  "description": "Teste técnico QA Júnior (Verzel) - card VZS-142: BDD/Gherkin executado com Playwright",
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test --project=api",
    "test:ui": "bddgen && playwright test --project=ui",
    "test:all": "bddgen && playwright test",
    "report": "playwright show-report",
